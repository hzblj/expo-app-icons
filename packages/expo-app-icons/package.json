{
  "name": "@hzblj/expo-app-icons",
  "version": "0.1.2",
  "description": "Alternate app icons for Expo: a config plugin that generates them and a native module that switches them at runtime on iOS and Android.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-app-icons.git",
    "directory": "packages/expo-app-icons"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-app-icons/issues"
  },
  "homepage": "https://github.com/hzblj/expo-app-icons#readme",
  "keywords": [
    "alternate-icons",
    "android",
    "app-icon",
    "config-plugin",
    "expo",
    "expo-module",
    "icon",
    "ios",
    "launcher-icon",
    "react-native"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./plugin": {
      "types": "./plugin/build/index.d.ts",
      "default": "./plugin/build/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/main/**",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "ios/*.podspec",
    "ios/*.swift",
    "plugin/build/**"
  ],
  "scripts": {
    "build": "rm -rf build plugin/build && tsc -p ./tsconfig.build.json && tsc -p ./plugin/tsconfig.json",
    "clean": "rm -rf build plugin/build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T concurrently \"tsc -p ./tsconfig.json\" \"tsc -p ./plugin/tsconfig.json --noEmit\"",
    "test": "node --import tsx --test plugin/test/*.test.ts"
  },
  "dependencies": {
    "@expo/image-utils": "^0.11.6 || ^0.12.0",
    "jimp-compact": "0.16.1"
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "xcode": "^3.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
